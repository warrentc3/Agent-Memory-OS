# MCP server image (stdio transport) — for registries/catalogs like Glama that
# start the server and introspect it (initialize + tools/list).
#
# The main ./Dockerfile runs the WEB console; this one runs the MCP server.
# Run it with an attached stdin:  docker run -i --rm agent-memory-os-mcp
#
#   docker build -f Dockerfile.mcp -t agent-memory-os-mcp .
#
FROM python:3.12-slim

# Pull the published package (includes the MCP server via the [mcp] extra).
RUN pip install --no-cache-dir "agent-memory-os[mcp]"

# A writable home for the SQLite store.
ENV AGENT_MEMORY_HOME=/data
VOLUME ["/data"]

# stdio MCP server: speaks JSON-RPC over stdin/stdout (use `docker run -i`).
ENTRYPOINT ["python", "-m", "agent_memory_os.mcp_server"]
