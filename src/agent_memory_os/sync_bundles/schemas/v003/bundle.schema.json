{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMemoryOS sync bundle v3 JSONL line",
  "description": "Version 3 adds organization records to the version 2 record set.",
  "oneOf": [
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/record"}
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["kind", "version"],
      "properties": {
        "kind": {"const": "bundle"},
        "version": {"const": 3},
        "node_name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "team": {
      "type": "object",
      "required": ["kind", "id", "name", "updated_at", "members"],
      "properties": {
        "kind": {"const": "team"},
        "id": {"type": "string"},
        "name": {"type": "string"},
        "updated_at": {"type": "string", "minLength": 1},
        "members": {}
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["kind", "id", "team_id", "name", "updated_at", "members"],
      "properties": {
        "kind": {"const": "project"},
        "id": {"type": "string"},
        "team_id": {"type": "string"},
        "name": {"type": "string"},
        "updated_at": {"type": "string", "minLength": 1},
        "members": {}
      },
      "additionalProperties": true
    },
    "orgTombstone": {
      "type": "object",
      "required": ["kind", "tomb_kind", "id", "deleted_at"],
      "properties": {
        "kind": {"const": "org_tombstone"},
        "tomb_kind": {"enum": ["team", "project"]},
        "id": {"type": "string"},
        "deleted_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "unknownRecord": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "bundle", "memory", "link", "profile", "tombstone",
              "team", "project", "org_tombstone"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "record": {
      "oneOf": [
        {"$ref": "../v001/bundle.schema.json#/$defs/memory"},
        {"$ref": "../v001/bundle.schema.json#/$defs/link"},
        {"$ref": "../v001/bundle.schema.json#/$defs/profile"},
        {"$ref": "../v002/bundle.schema.json#/$defs/tombstone"},
        {"$ref": "#/$defs/team"},
        {"$ref": "#/$defs/project"},
        {"$ref": "#/$defs/orgTombstone"},
        {"$ref": "#/$defs/unknownRecord"}
      ]
    }
  }
}
