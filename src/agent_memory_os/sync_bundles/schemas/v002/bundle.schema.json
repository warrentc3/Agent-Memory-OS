{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMemoryOS sync bundle v2 JSONL line",
  "description": "Version 2 adds tombstones to the version 1 record set.",
  "oneOf": [
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/record"}
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["kind", "version"],
      "properties": {
        "kind": {"const": "bundle"},
        "version": {"const": 2},
        "node_name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "tombstone": {
      "type": "object",
      "required": ["kind", "id", "deleted_at"],
      "properties": {
        "kind": {"const": "tombstone"},
        "id": {"type": "string"},
        "deleted_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "unknownRecord": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["bundle", "memory", "link", "profile", "tombstone"]
          }
        }
      },
      "additionalProperties": true
    },
    "record": {
      "oneOf": [
        {"$ref": "../v001/bundle.schema.json#/$defs/memory"},
        {"$ref": "../v001/bundle.schema.json#/$defs/link"},
        {"$ref": "../v001/bundle.schema.json#/$defs/profile"},
        {"$ref": "#/$defs/tombstone"},
        {"$ref": "#/$defs/unknownRecord"}
      ]
    }
  }
}
