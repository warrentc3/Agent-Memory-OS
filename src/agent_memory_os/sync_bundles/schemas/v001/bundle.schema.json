{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMemoryOS sync bundle v1 JSONL line",
  "description": "Validate one line at a time; whole-bundle order is enforced by the codec.",
  "oneOf": [
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/record"}
  ],
  "$defs": {
    "legacyTimestamp": {"type": "string", "minLength": 1},
    "optionalLegacyTimestamp": {
      "anyOf": [
        {"$ref": "#/$defs/legacyTimestamp"},
        {"type": "null"}
      ]
    },
    "header": {
      "type": "object",
      "required": ["kind", "version"],
      "properties": {
        "kind": {"const": "bundle"},
        "version": {"const": 1},
        "node_name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "required": [
        "kind", "id", "owner", "scope", "type", "content", "summary",
        "tags", "visibility", "source", "confidence", "importance",
        "created_at", "updated_at", "decay_policy", "decay_half_life_days",
        "access_count", "pinned", "helpful_count", "unhelpful_count"
      ],
      "properties": {
        "kind": {"const": "memory"},
        "id": {"type": "string"},
        "owner": {"type": "string"},
        "scope": {"type": "string"},
        "type": {"type": "string"},
        "content": {"type": "string"},
        "summary": {"type": "string"},
        "tags": {"type": "string"},
        "visibility": {"type": "string"},
        "source": {"type": "string"},
        "confidence": {"type": "number"},
        "importance": {"type": "number"},
        "created_at": {"$ref": "#/$defs/legacyTimestamp"},
        "updated_at": {"$ref": "#/$defs/legacyTimestamp"},
        "acl_updated_at": {"$ref": "#/$defs/optionalLegacyTimestamp"},
        "expires_at": {"$ref": "#/$defs/optionalLegacyTimestamp"},
        "decay_policy": {"type": "string"},
        "decay_half_life_days": {"type": "number"},
        "last_accessed_at": {"$ref": "#/$defs/optionalLegacyTimestamp"},
        "access_count": {"type": "integer"},
        "pinned": {"type": "integer"},
        "helpful_count": {"type": "integer"},
        "unhelpful_count": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": [
        "kind", "src_id", "dst_id", "relation", "weight", "created_at",
        "updated_at", "activation_count", "source"
      ],
      "properties": {
        "kind": {"const": "link"},
        "src_id": {"type": "string"},
        "dst_id": {"type": "string"},
        "relation": {"type": "string"},
        "weight": {"type": "number"},
        "created_at": {"$ref": "#/$defs/legacyTimestamp"},
        "updated_at": {"$ref": "#/$defs/legacyTimestamp"},
        "last_activated_at": {"$ref": "#/$defs/optionalLegacyTimestamp"},
        "activation_count": {"type": "integer"},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": ["kind", "agent_id", "type_weights", "scope_weights", "updated_at"],
      "properties": {
        "kind": {"const": "profile"},
        "agent_id": {"type": "string"},
        "type_weights": {"type": "string"},
        "scope_weights": {"type": "string"},
        "updated_at": {"$ref": "#/$defs/legacyTimestamp"}
      },
      "additionalProperties": true
    },
    "unknownRecord": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "not": {"enum": ["bundle", "memory", "link", "profile"]}
        }
      },
      "additionalProperties": true
    },
    "record": {
      "oneOf": [
        {"$ref": "#/$defs/memory"},
        {"$ref": "#/$defs/link"},
        {"$ref": "#/$defs/profile"},
        {"$ref": "#/$defs/unknownRecord"}
      ]
    }
  }
}
